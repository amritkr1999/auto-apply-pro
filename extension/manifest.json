{
  "manifest_version": 3,
  "name": "EasyNaukri Harvester & Auto Apply Node",
  "version": "1.0.0",
  "description": "Background job harvester and auto-apply extension node for EasyNaukri (Auto Apply Pro).",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://*.naukri.com/*",
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.instahyre.com/*",
    "*://*.wellfound.com/*",
    "http://localhost:8060/*",
    "http://127.0.0.1:8060/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "*://*.easynaukri.online/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": ["content_linkedin.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}
