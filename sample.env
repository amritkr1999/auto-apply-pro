# Copy this file to .env and fill in your local values.

# Database
DB_NAME=autoapplypro
DB_USER=amrit
DB_PASSWORD=changeme

# Backend OAuth / integrations
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8060/api/v1/outreach/oauth2/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8060/api/v1/auth/callback/github
FRONTEND_URL=http://localhost:5173

# Mail
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=your-app-password

# Payments
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
USE_LOCAL_MODEL=false

# CORS Configuration
# Comma-separated list of allowed origins. Set to * or your production domain in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Ollama Configuration
# Set to http://host.docker.internal:11434 in Docker environment to access Ollama running on the host machine.
OLLAMA_BASE_URL=http://localhost:11434
